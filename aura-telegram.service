[Unit]
Description=Aura Telegram Bot
After=network-online.target
Wants=network-online.target
# Cap restart attempts: 5 failures inside 5 minutes and systemd stops retrying
# instead of looping forever. StartLimit* belong in [Unit] — placed under
# [Service], systemd silently ignores them.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=dusan
Group=dusan
WorkingDirectory=/home/dusan/aura-code
EnvironmentFile=/home/dusan/.secrets/agents.env
# Run the COMPILED build with plain node.
#
# Do NOT use `npx tsx src/tools/telegram-bot.ts`: tsx is not a dependency and is
# not in node_modules, so npx re-resolves and installs it from the network on
# every start. That pinned one CPU core at 100% for as long as the unit ran
# (~110s CPU per 110s wall), grew ~/.npm/_npx to 3.1 GB, and the bot never even
# reached its startup banner. With plain node it starts in under a second at
# ~0.2s CPU.
#
# Consequence: `npm run build` is required after editing src/ — this no longer
# transpiles on the fly. Use /usr/bin/node, not an nvm path, which is pinned to
# one node version and breaks on upgrade.
ExecStart=/usr/bin/node /home/dusan/aura-code/dist/tools/telegram-bot.js
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
