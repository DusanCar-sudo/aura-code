# here does not end up tracked again.
aura-analysis-video/
aura-token-video/
hyperframes/

# Agent-tool config directories, ignored wholesale.
#
# These used to be listed skill by skill, because some of .agents/skills was
# tracked deliberately and a blanket rule would have hidden which absences were
# intentional. That reasoning expired when the vendored directories were
# removed from the repo entirely: nothing under them is tracked now, so there
# is nothing for a blanket rule to obscure.
#
# Every one of these is written by a third-party agent tool into a checkout of
# whatever project it is pointed at. None of it is Aura source, none of it
# should ship in the npm package, and none of it should reappear in the repo
# because a tool happened to run here. Note that `.agents/skills` is still a
# supported location at *runtime* — src/plugins/project-skills.ts reads it in
# the user's project. Ignoring it here only stops Aura's own checkout from
# carrying someone else's skills.
.agents/
.qwen/
.kilocode/
.openclaude/
.claude/skills/
.grok/
.codex/
.cursor/
.crush/
.rubycode/
.impeccable/
.windsurf/

# Agent-tool hooks and per-tool rule files, same species as the directories
# above — written into whatever checkout the tool is pointed at.
.github/hooks/
.clinerules
.windsurfrules
.rubycode.json

# Personal, per Claude Code's own convention (settings.json is the shared one).
.claude/settings.local.json
