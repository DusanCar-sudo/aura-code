council/
dreams/

# Video and media projects, moved to ../projects/. Ignored so a stray render
# here does not end up tracked again.
aura-analysis-video/
aura-token-video/
hyperframes/

# Third-party skills vendored by the skills installer, not Aura source.
# Listed by name rather than ignoring .agents/skills/ wholesale, because 24
# skills in that directory ARE tracked deliberately — a blanket rule would
# leave no way to tell which absences are intentional. A new skill that
# belongs in the repo is added normally; one installed by the tool goes here.
