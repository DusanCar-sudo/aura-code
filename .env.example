# aura-code — API keys
# Copy this file to .env and fill in the keys you need.
# Never commit .env to git.

# Anthropic (Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT models)
OPENAI_API_KEY=sk-...

# Google (Gemini models)
GOOGLE_API_KEY=...

# xAI (Grok models)
XAI_API_KEY=...

# OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...

# Xiaomi MiMo — get from platform.xiaomimimo.com/api-keys
# Token Plan endpoint (Singapore by default — change region if needed)
XIAOMI_API_KEY=tp-...
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Zhipu GLM (Z.ai) — get from z.ai/manage-apikey/apikey-list
# Two endpoints:
#   General/International (default):  https://api.z.ai/api/paas/v4
#   Coding Plan (subscription quota): https://api.z.ai/api/coding/paas/v4
# Use glm-* for the general endpoint or zhipu-coding/<model> for the Coding
# Plan, or set ZHIPU_BASE_URL to force one.
ZHIPU_API_KEY=...
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4

# Default model (overridden by --model flag)
# AURA_MODEL=mimo-v2.5-pro

# Shell/git tool output goes through RTK when `rtk` is on PATH (compressed
# output, far fewer context tokens). Set to 0 to run bare commands instead.
# AURA_RTK=0

# A reply that collapses into repeating one phrase is cut off and retried
# instead of running to the model's output cap. Set to 0 to let it run.
# AURA_REPETITION_GUARD=0

# ── Web search (optional) ────────────────────────────────────────────────────
# web_search falls back to scraping DuckDuckGo when no key is set. DuckDuckGo
# blocks many IPs with a bot-check page; when that happens the tool reports an
# explicit error rather than pretending the query matched nothing. Set one of
# these for a search backend that actually works:
#   Brave  — free tier, 2,000 queries/month: https://brave.com/search/api/
#   Tavily — free tier, built for agents:    https://tavily.com
BRAVE_API_KEY=
TAVILY_API_KEY=

# Output-token ceiling per API call (default 16384 for OpenAI-compatible
# endpoints). Reasoning models spend this budget on internal thinking BEFORE
# emitting visible content, so at high reasoning effort a large artefact can be
# cut off with finish_reason "length" and empty content. Raise this if long
# single-file output (e.g. :designx) keeps coming back truncated.
# AURA_MAX_TOKENS=32768

# Seconds of silence between stream chunks before a response is treated as
# stalled (default 60000 ms). Reasoning models can pause far longer than this
# between finishing their internal thinking and emitting a large payload — a
# :designx run writing a 20 KB document died here at 60s. Raise it for
# long-single-artefact work; AURA_STREAM_IDLE_MS=0 disables the check.
# AURA_STREAM_IDLE_MS=240000
